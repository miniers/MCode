# 复制为 .env 后填写；.env 已被 git 忽略。
# scripts/package_personal.sh 使用的 Developer ID Application 签名身份。
MCODE_SIGN_IDENTITY="Developer ID Application: Your Name (TEAMID)"

# scripts/release.sh：agent 可选 claude、codex 或 pi，默认 claude。
# 模型留空使用 agent 默认模型；pi 可写 provider/id。
# MCODE_RELEASE_AGENT=pi
# MCODE_RELEASE_MODEL=
